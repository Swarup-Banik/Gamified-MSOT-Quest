# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
CLIENT_BASE_URL=http://localhost:3000

# Database & Cache
# If DATABASE_URL and REDIS_URL are not provided or unreachable, MSOT Quest automatically
# runs with high-fidelity embedded SQLite/PGlite and in-memory Redis cluster emulation.
DATABASE_URL=postgresql://msot_admin:msot_secret_2026@localhost:5432/msot_quest?schema=public
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super-secure-msot-quest-jwt-secret-key-2026!
SESSION_SECRET=msot-session-secret-salt-development
ALLOWED_EMAIL_DOMAINS=msot.edu.in
DEMO_MODE=true
DPDP_GUARDIAN_CONSENT_ENABLED=false

# OAuth / OIDC Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail Delivery (Local Mailpit: SMTP 1025, Web UI 8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@msot.edu.in
MAILPIT_WEB_URL=http://localhost:8025

# Anti-Gaming & XP Balancing
DAILY_XP_SOFT_CAP=150
Z_SCORE_ANOMALY_THRESHOLD=3.0
MAX_STREAK_FREEZES=2

# AI LLM Provider Configuration
# Supported types: 'mock', 'hosted', 'ollama'
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_ENDPOINT=http://localhost:11434

# Notifications
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
